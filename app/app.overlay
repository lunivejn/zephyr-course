#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    leds {
        compatible = "gpio-leds";

        user_led0: user_led0 {
            gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
            label = "User LED0";
        };
    };

    aliases {
        led0 = &user_led0;
        app-led = &user_led0;
    };

    our_driver0: our_driver {
        compatible = "our,driver";
        status = "okay";
    };
};